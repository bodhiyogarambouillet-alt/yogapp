# Copiez ce fichier en .env.local et collez votre clé (Google AI Studio).
# Ne jamais committer .env.local.
GEMINI_API_KEY=

# Facultatif — modèles (valeurs par défaut ci-dessous)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL_SECOURS=gemini-3.5-flash-lite

# Facultatif — délai laissé au modèle principal avant de basculer sur le secours (ms)
# GEMINI_DELAI_SEANCE_MS=20000
# GEMINI_DELAI_FICHE_MS=12000
