# Copiez ce fichier en .env.local et remplissez-le. Ne jamais committer .env.local.

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL_SECOURS=gemini-3.5-flash-lite
# GEMINI_DELAI_SEANCE_MS=20000
# GEMINI_DELAI_FICHE_MS=12000

# --- Supabase (Project Settings → API Keys) ---
# URL et clé PUBLIABLE : utilisées par le navigateur (protégées par la RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Clé SECRÈTE (sb_secret_…) : fonctions serveur et scripts seulement. Ne la partagez jamais.
SUPABASE_SECRET_KEY=
